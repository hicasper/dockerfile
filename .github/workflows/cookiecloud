name: Build CookieCloud Docker Image

on:
  push:
  schedule:
    - cron: "3 7 */15 * *"
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      -
        name: Checkout repository
        uses: actions/checkout@v6
        with:
          repository: 'easychen/CookieCloud'
      -
        name: Get upstream version
        id: getversion
        run: |
          echo "CLEAN_VER=$(curl -sL https://api.github.com/repos/easychen/CookieCloud/releases/latest | jq -r .name | sed -E 's/.*([0-9]+\.[0-9]+\.[0-9]+).*/\1/')" >> $GITHUB_OUTPUT
          sed -i 's/node:16-alpine3.15/node:22-alpine/1' ./docker/Dockerfile
      -
        name: Set up QEMU
        uses: docker/setup-qemu-action@v4
      -
        name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4
      -
        name: Login to Docker Hub
        uses: docker/login-action@v4
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
      -
        name: Build and push
        uses: docker/build-push-action@v7
        with:
          push: true
          context: ./docker
          platforms: linux/amd64,linux/arm64
          tags: >-
            ${{ secrets.DOCKERHUB_USERNAME }}/cookiecloud:latest,
            ${{ secrets.DOCKERHUB_USERNAME }}/cookiecloud:${{ steps.getversion.outputs.CLEAN_VER }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
